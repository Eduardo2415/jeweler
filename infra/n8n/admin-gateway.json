                },
                "conditions": [
                  {
                    "id": "c3d4e5f6-3333-3333-3333-cccccccccccc",
                    "leftValue": "={{ $('Normalizar Sesion Admin').item.json.action }}",
                    "rightValue": "upload-image",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "name": "filter.operator.equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "upload-image"
            }
          ]
        },
        "options": {}
      },
      "id": "3bbff201-1b2c-47a3-b921-2a1cef5031b2",
      "name": "Router de Acciones Admin",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        300,
        0
      ]
    },
    {
