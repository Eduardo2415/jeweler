{
  "name": "API - Admin Gateway",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "admin-gateway",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "5a4f7831-7b19-482a-a92f-a9cb6014e782",
      "name": "Webhook Admin Gateway",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1000,
        150
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.DIRECTUS_URL }}/items/ji_sesiones_admin",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filter[admin_token][_eq]",
              "value": "={{ $json.body.admin_token }}"
            },
            {
              "name": "filter[estado_activo][_eq]",
              "value": "true"
            },
            {
              "name": "fields",
              "value": "id,admin_token,fecha_expira,estado_activo"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "e305e551-789a-4c22-b6ab-bcbece44012c",
      "name": "Validar Sesion Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -750,
        150
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "7tjiKRmwXUpshjFn",
          "name": "directus n8n"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook Admin Gateway').item.json.body || {};\nconst sesion = $json.data?.[0];\n\nif (!body.admin_token) {\n  return [{\n    json: {\n      autorizado: false,\n      final_response: {\n        status: 'error',\n        message: 'Token de administrador requerido.'\n      }\n    }\n  }];\n}\n\nif (!body.action) {\n  return [{\n    json: {\n      autorizado: false,\n      final_response: {\n        status: 'error',\n        message: 'Acción requerida.'\n      }\n    }\n  }];\n}\n\nif (!sesion) {\n  return [{\n    json: {\n      autorizado: false,\n      final_response: {\n        status: 'error',\n        message: 'Sesión administrativa inválida o inactiva.'\n      }\n    }\n  }];\n}\n\nconst fechaExpira = new Date(sesion.fecha_expira);\nconst ahora = new Date();\nif (fechaExpira <= ahora) {\n  return [{\n    json: {\n      autorizado: false,\n      final_response: {\n        status: 'error',\n        message: 'Sesión administrativa expirada.'\n      }\n    }\n  }];\n}\n\nconst allowedActions = ['get-products', 'create-product', 'upload-image'];\nif (!allowedActions.includes(body.action)) {\n  return [{\n    json: {\n      autorizado: false,\n      final_response: {\n        status: 'error',\n        message: `Acción no permitida para el panel de administración: ${body.action}`\n      }\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    autorizado: true,\n    action: body.action,\n    payload: body.payload || {},\n    session_id: sesion.id\n  }\n}];"
      },
      "id": "79b882e3-2cb0-464a-a039-37f8d752945a",
      "name": "Normalizar Sesion Admin",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -500,
        150
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.autorizado }}",
              "value2": true
            }
          ]
        }
      },
      "id": "358ef902-12b4-4fa4-a212-be20ac28bd2e",
      "name": "¿Autorizado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -250,
        150
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=http://directus-dpfk3eo6bvn57ljy7z0vlsek:8055/items/ji_sesiones_admin/{{ $('Normalizar Sesion Admin').item.json.session_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"ultimo_uso\": new Date().toISOString() } }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "92f7c001-fd34-4b51-b921-2a1cef5031b2",
      "name": "Actualizar Ultimo Uso",
