      ]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    final_response: $('Normalizar Archivo').item.json.final_response || {\n      status: 'error',\n      message: 'Fallo al procesar o cargar la imagen.'\n    }\n  }\n}];"
      },
