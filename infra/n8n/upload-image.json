{
  "name": "API - Upload Image",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "upload-image",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "e3a4f831-7b19-482a-a92f-a9cb6014e784",
      "name": "Webhook Upload Image",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -608,
        160
      ],
      "webhookId": "1e6d9e5b-b784-438c-84f0-1c97946d5ab8"
    },
    {
      "parameters": {
        "jsCode": "const binaryData = $input.item.binary || {};\nconst fileKey = Object.keys(binaryData)[0];\n\nif (!fileKey) {\n  return [{\n    json: {\n      ok: false,\n      final_response: {\n        status: 'error',\n        message: 'No se detectó ningún archivo binario en la petición.'\n      }\n    }\n  }];\n}\n\n// Read folder parameter, fallback to 'productos'\nlet folder = ($input.item.json.body && $input.item.json.body.folder) || \n             ($input.item.json.query && $input.item.json.query.folder) || \n             'productos';\n\n// Clean folder name\nfolder = folder.replace(/[^a-zA-Z0-9\\-_/]/g, '').trim();\nif (!folder) {\n  folder = 'productos';\n}\n\nconst ext = binaryData[fileKey].fileExtension || 'jpg';\nconst generatedName = `joyas-${Date.now()}-${Math.floor(Math.random()*10000)}.${ext}`;\n\nreturn [{\n  json: {\n    ok: true,\n    binaryPropertyName: fileKey,\n    fileName: `${folder}/${generatedName}`\n  },\n  binary: binaryData\n}];"
      },
      "id": "528ef902-12b4-4fa4-a212-be20ac28bd2d",
      "name": "Normalizar Archivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -352,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ok }}",
              "value2": true
            }
          ]
        }
      },
      "id": "d358ef92-12b4-4fa4-a212-be20ac28bd2e",
      "name": "¿Archivo Valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -96,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const key = $('Subir a MinIO (S3)').item.json.key || $('Normalizar Archivo').item.json.fileName;\nconst baseUrl = 'https://minio.em-cloud.top/joyeria-assets';\n\nreturn [{\n  json: {\n    final_response: {\n      status: 'success',\n      url: `${baseUrl}/${key}`\n    }\n  }\n}];"
      },
      "id": "b79b882e-2cb0-464a-a039-37f8d752945d",
      "name": "Respuesta Exito Carga",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
