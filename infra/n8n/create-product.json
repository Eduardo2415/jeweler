        -600,
        150
      ],
      "webhookId": "40c1ca28-2a75-4316-a3e9-eede3d681367"
    },
    {
      "parameters": {
        "url": "http://directus-dpfk3eo6bvn57ljy7z0vlsek:8055/items/ji_sesiones_admin",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filter[admin_token][_eq]",
              "value": "={{ $json.body.admin_token }}"
            },
            {
              "name": "filter[estado_activo][_eq]",
              "value": "true"
            },
            {
              "name": "fields",
              "value": "id,fecha_expira,estado_activo"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "bb779339-d6ca-429b-a5ef-e0fe165387c4",
      "name": "Validar Sesion Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -600,
        150
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "7tjiKRmwXUpshjFn",
          "name": "directus n8n"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook Create Product').item.json.body || {};\nconst session = $json.data?.[0];\nconst price = Number(body.price);\nconst stock = Number(body.stock);\nconst hasSalePrice = body.sale_price !== null && body.sale_price !== undefined && body.sale_price !== '';\nconst salePrice = hasSalePrice ? Number(body.sale_price) : null;\nlet error = null;\n\nif (!body.admin_token) {\n  error = 'Token de administrador requerido.';\n} else if (!session) {\n  error = 'Sesión administrativa inválida o inactiva.';\n} else if (new Date(session.fecha_expira) <= new Date()) {\n  error = 'Sesión administrativa expirada.';\n} else if (!body.name || !body.description || !Number.isFinite(price) || price <= 0) {\n  error = 'Faltan campos obligatorios o el precio regular es inválido.';\n} else if (!Number.isInteger(stock) || stock < 0) {\n  error = 'El stock debe ser un número entero mayor o igual a cero.';\n} else if (hasSalePrice && (!Number.isFinite(salePrice) || salePrice <= 0 || salePrice >= price)) {\n  error = 'El precio de oferta debe ser mayor que cero y menor que el precio regular.';\n}\n\nif (error) {\n  return [{\n    json: {\n      ok: false,\n      final_response: {\n        status: 'error',\n        message: error,\n        data: null\n      }\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    directus_payload: {\n      name: body.name,\n      categoryId: Number(body.categoryId) || 1,\n      price,\n      sale_price: salePrice,\n      stock,\n      description: body.description,\n      image: body.image || null,\n      sizes: Array.isArray(body.sizes) ? body.sizes : null\n    }\n  }\n}];"
      },
      "id": "528ef902-12b4-4fa4-a212-be20ac28bd2c",
      "name": "Formatear Datos Producto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -350,
        150
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ok }}",
              "value2": true
            }
          ]
        }
      },
      "id": "d358ef92-12b4-4fa4-a212-be20ac28bd2d",
      "name": "¿Datos Validos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -100,
        150
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://directus-dpfk3eo6bvn57ljy7z0vlsek:8055/items/ji_productos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $('Formatear Datos Producto').item.json.directus_payload }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a105e551-789a-4c22-b6ab-bcbece44012d",
      "name": "Guardar en Directus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        150,
        50
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "7tjiKRmwXUpshjFn",
          "name": "directus n8n"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const res = $('Guardar en Directus').item.json.data;\nreturn [{\n  json: {\n    final_response: {\n      status: 'success',\n      message: 'Joya agregada correctamente.',\n      data: {\n        id: res.id\n      },\n      id: res.id\n    }\n  }\n}];"
      },
      "id": "b79b882e-2cb0-464a-a039-37f8d752945c",
      "name": "Respuesta Exito Insercion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        50
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    final_response: $('Formatear Datos Producto').item.json.final_response || {\n      status: 'error',\n      message: 'Error al registrar el producto.'\n    }\n  }\n}];"
      },
      "id": "c7b2c803-fd13-4b51-b921-2a1cef5031b4",
      "name": "Respuesta Error Formato",
